
{
    "name": "Txt Extensions",
    "description": "Base Level Extension",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": ["storage"],
    "action": {
      "default_popup": "Txt.html"
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "txt-extensions@yourname.com",
        "data_collection_permissions": {
          "required": ["none"]
        }
      }
    }
}  